                "exec": [
                  "const b=pm.response.json();pm.test('HTTP200与业务200',()=>{pm.expect(pm.response.code).eq(200);pm.expect(b.code).eq(200);});pm.test(\"空值真实返回\",()=>{const x=b.data.items.find(x=>x.id===1016);pm.expect(x.companyId).eq(202);pm.expect(x.companyLogo).eq(null);const y=b.data.items.find(x=>x.id===1020);pm.expect(y.publishedAt).eq(null);pm.expect(y.deadline).eq(null);pm.expect(y.category).eq(null);pm.expect(b.data.items.find(x=>x.id===1005).requiredSkills).eq(null);pm.expect(b.data.items.find(x=>x.id===1007).requiredSkills).eq('跨部门沟通');pm.expect(b.data.items.find(x=>x.id===1019).directionCode).eq(null);});pm.test(\"结构化展示投影原样返回且不放大行数\",()=>{const x=b.data.items.find(x=>x.id===1022);pm.expect(x.requiredSkills).eq(['Java','Redis','Java'].join(String.fromCharCode(10)));pm.expect(x.requiredAbilitiesSource).eq('STRUCTURED');pm.expect(x.requiredAbilitiesVersion).eq(7);pm.expect(b.data.items.filter(x=>x.id===1022)).lengthOf(1);});"
                ]
              }
            }
