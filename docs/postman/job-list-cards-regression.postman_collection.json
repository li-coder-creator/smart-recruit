          "name": "001 登录隔离身份1",
          "request": {
            "method": "POST",
            "url": "{{rqHost}}/user/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"rq_input_1\",\"password\":\"{{rqPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('runJobListCardsRegression')!=='true'||pm.environment.get('rqFixtureReady')!=='true'||pm.environment.get('rqHost')!=='http://127.0.0.1:18092'){pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();pm.test('HTTP200与业务200',()=>{pm.expect(pm.response.code).eq(200);pm.expect(b.code).eq(200);});pm.collectionVariables.set('rqToken1',b.data);"
                ]
              }
            }
          ]
        },
