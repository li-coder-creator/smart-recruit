            "method": "GET",
            "url": "{{rqHost}}/job?size=100",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rqToken1}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('runJobListCardsRegression')!=='true'||pm.environment.get('rqFixtureReady')!=='true'||pm.environment.get('rqHost')!=='http://127.0.0.1:18092'){pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();pm.test('HTTP200与业务200',()=>{pm.expect(pm.response.code).eq(200);pm.expect(b.code).eq(200);});pm.test(\"27个招聘中岗位且不重复\",()=>{pm.expect(b.data.total).eq(27);pm.expect(b.data.items).lengthOf(27);pm.expect(new Set(b.data.items.map(x=>x.id)).size).eq(27);pm.expect(b.data.items.every(x=>x.status===0)).eq(true);});pm.test(\"企业及完整卡片字段\",()=>{const x=b.data.items.find(x=>x.id===1001);pm.expect(x.companyId).eq(201);pm.expect(x.companyName).eq('已审核回归企业');pm.expect(x.companyLogo).eq('https://example.invalid/job-card-logo.png');pm.expect(x.summary).eq('岗位卡片简介');pm.expect(x.benefits).eq('弹性工作、带薪年假');pm.expect(x.requiredSkills).eq('Java');pm.expect(x.preferredSkills).eq('Docker');pm.expect(x.directionCode).eq('BACKEND');pm.expect(x.requiredAbilitiesSource).eq('LEGACY_TEXT');pm.expect(x.requiredAbilitiesVersion).eq(0);pm.expect(x.publishedAt).eq('2026-10-01T10:00:00');pm.expect(x.deadline).eq('2026-12-31');pm.expect(x.team).eq('平台组');pm.expect(x.salaryUnit).eq('MONTH');pm.expect(x.negotiable).eq(false);pm.expect(x).include.all.keys('id','title','category','employment','status','city','experience','education','salaryMin','salaryMax','updateTime');});pm.collectionVariables.set('jcAll',JSON.stringify(b.data));"
                ]
              }
            }
          ]
        },
